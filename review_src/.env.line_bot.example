# 由專案根目錄「設定LINE機器人.cmd」建立為 ../.env.line_bot 後填寫；此範本不得放入真實密鑰。

# LINE Developers Console -> Basic settings
LINE_CHANNEL_SECRET=

# LINE Developers Console -> Messaging API
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers Console 要填的公開 HTTPS URL，例如：
# https://stockbot.example.com/line/webhook
LINE_WEBHOOK_PUBLIC_URL=
LINE_VERIFY_SIGNATURE=true

# 一鍵啟動器會用此相對路徑建立免費臨時 Tunnel，並自動更新/驗證 LINE Webhook。
CLOUDFLARED_EXE_PATH=runtime/cloudflared/cloudflared.exe

# 只有自己使用時可填自己的 LINE user ID；多人以逗號分隔。留空代表不限制好友。
LINE_ALLOWED_USER_IDS=
LINE_REPLY_TIMEOUT_SECONDS=12
LINE_CONTENT_TIMEOUT_SECONDS=12
LINE_MAX_IMAGE_BYTES=8388608
# 包含市場 API、Qwen 與 LINE Reply 的總預算；必須低於 LINE reply token 實用時限。
LINE_TOTAL_REPLY_BUDGET_SECONDS=45
# 舊版單程序短期對話限制；persistent storage 啟用後仍作相容性保護。
LINE_CONVERSATION_TTL_SECONDS=1800
LINE_CONVERSATION_MAX_SESSIONS=1000
LINE_CONVERSATION_MAX_TURNS=8
LINE_CONVERSATION_MAX_USER_CHARS=2400

# 每位 LINE 使用者／聊天範圍獨立的加密上文記憶。路徑相對於專案根目錄。
LINE_MEMORY_STORAGE=sqlite
LINE_MEMORY_DB_PATH=review_src/data/line_conversation_memory.sqlite3
LINE_MEMORY_KEY_FILE=review_src/data/line_conversation_memory.key
LINE_MEMORY_CHANNEL_NAMESPACE=primary-line-channel
LINE_MEMORY_RECENT_EXCHANGES=8
LINE_MEMORY_PROMPT_CHARACTER_BUDGET=6000
LINE_MEMORY_COMPACTION_TRIGGER=3
LINE_MEMORY_COMPACTION_BATCH_SIZE=10
LINE_MEMORY_COMPACTION_TIMEOUT_SECONDS=60
# 原始逐字問答保存 24 小時；加密 session 與摘要保存 30 天。
LINE_MEMORY_RAW_RETENTION_SECONDS=86400
LINE_MEMORY_SUMMARY_RETENTION_SECONDS=2592000
LINE_MEMORY_PRIVACY_NOTICE_VERSION=2026-08-28
LINE_MEMORY_LONG_TERM_APPROVED=true

# 獨立唯讀股票 API；token 留空時由啟動器每次自動安全產生。
BOT_MARKET_DATA_BASE_URL=http://127.0.0.1:8010
BOT_MARKET_DATA_TOKEN=
BOT_MARKET_DATA_TIMEOUT_SECONDS=15
BOT_ENABLE_UNVERIFIED_TRADES=false

# 本機 Qwen3.8-27B Ollama OpenAI-compatible API。
QWEN_ENABLED=true
QWEN_BASE_URL=http://127.0.0.1:8020/v1
QWEN_NATIVE_BASE_URL=http://127.0.0.1:8020
QWEN_TEXT_API_MODE=native
QWEN_API_KEY=ollama
QWEN_MODEL_ID=taiwan-stock-qwen
# Required for authorized canary finalization; use the probed lowercase SHA-256 digest.
QWEN_MODEL_DIGEST=
# 摘要使用較輕量的本機模型，避免 27B 背景摘要阻塞下一則使用者回覆。
QWEN_MEMORY_MODEL_ID=qwen3-vl:8b-instruct
QWEN_MODEL_FILE=models/qwen3.8-27b/Qwen3.8-27B-Q4_K_M.gguf
QWEN_CONTEXT_TOKENS=16384
QWEN_PARALLEL=1
QWEN_MAX_OUTPUT_TOKENS=900
QWEN_NUM_BATCH=1024
# 下一代封包目前只允許 off 或 shadow；shadow 僅在正式 LINE 回覆成功後執行候選模型，永不取代正式回覆。
# 冷模型時 shadow 會延後，執行中的 shadow 必須能被新進 interactive LINE 工作取消。
LINE_MODEL_V2_ROLLOUT=off
# Phase E only: canary requires a signed authorization bound to the frozen runtime source.
LINE_MODEL_V2_CANARY_PERCENT=0
LINE_MODEL_V2_RELEASE_AUTHORIZATION_PATH=
LINE_MODEL_V2_RELEASE_AUTHORIZATION_KEY=
# 預設依分析深度選 stable 16K profile。32K candidate 必須明確指定且仍需通過發布 gates。
LINE_MODEL_V2_PROFILE=
# 受控新聞研究只在 post-reply shadow 使用；模型本身不能上網，新聞不能覆寫 DB/referee。
LINE_MODEL_RESEARCH_ROLLOUT=off
LINE_MODEL_RESEARCH_TIMEOUT_SECONDS=6
LINE_MODEL_RESEARCH_MAX_EVENTS_PER_QUERY=4
LINE_MODEL_RESEARCH_CACHE_MAX_ENTRIES=256
# 這些是工程預設值，不是 GDELT 或 LINE 官方強制規定。
NEWS_SEARCH_POSITIVE_TTL_SECONDS=600
NEWS_SEARCH_NEGATIVE_TTL_SECONDS=120
NEWS_SEARCH_METADATA_RETENTION_DAYS=30
NEWS_SEARCH_RAW_BODY_RETENTION_SECONDS=0
# 只供內部驗收的固定情境 POST endpoint；受 BOT_MARKET_DATA_TOKEN 保護，不接受任意 prompt。
LINE_MODEL_BENCHMARK_ENABLED=false
LINE_MODEL_BENCHMARK_TIMEOUT_SECONDS=180
# 卸載/冷載入只能在已確認維護窗執行；一般 contention 探針不會呼叫它。
LINE_MODEL_COLD_PROBE_ENABLED=false
# 僅 native maintenance preload 使用（20m server load timeout + 60s buffer）；一般推理上限不變。
LINE_MODEL_COLD_PROBE_TIMEOUT_SECONDS=1260
# 單 GPU 的 production interactive 工作使用實測 P95 做 deadline admission；預測會超時就提早回 DB fallback。
LINE_MODEL_INTERACTIVE_P95_MS=15000
LINE_MODEL_VISION_P95_MS=35000
LINE_MODEL_PREEMPTION_P95_MS=2500
LINE_REPLY_TELEMETRY_ENABLED=true
LINE_REPLY_TELEMETRY_PATH=logs/line_model_shadow/line_reply_telemetry.jsonl
# 預設不得在服務啟動時搶先載入模型；需要維護窗預熱時才明確開啟。
LINE_MODEL_BACKGROUND_PREWARM=true
LINE_MODEL_COLD_WARMUP_P95_MS=70000
QWEN_ENABLE_THINKING=false
QWEN_TEMPERATURE=0.2
QWEN_TOP_P=0.8
QWEN_TIMEOUT_SECONDS=40
# -1 代表服務運行期間常駐 VRAM；關閉啟動視窗後會釋放。
QWEN_KEEP_ALIVE=-1

# 圖表圖片辨識使用獨立的本機視覺模型。圖片只在記憶體內處理，辨識值一律標示為 estimated，
# 並以唯讀官方行情交叉驗證；不得進入裁判層或覆寫正式技術指標。
QWEN_VISION_ENABLED=true
QWEN_VISION_BASE_URL=http://127.0.0.1:8020
QWEN_VISION_MODEL_ID=qwen3-vl:8b-instruct
QWEN_VISION_TIMEOUT_SECONDS=35
QWEN_VISION_MAX_OUTPUT_TOKENS=1200
QWEN_VISION_TEMPERATURE=0
QWEN_VISION_KEEP_ALIVE=-1

# 可攜式服務路徑與本機連接埠。
OLLAMA_EXE_PATH=runtime/ollama/ollama.exe
OLLAMA_MODELS_PATH=models/ollama
OLLAMA_MAX_LOADED_MODELS=2
# NVIDIA 主機可設 false，避免掃描不使用的 AMD/Vulkan 顯示核心；AMD 主機請留空。
OLLAMA_VULKAN=
QWEN_SERVER_PORT=8020
BOT_MARKET_DATA_PORT=8010
LINE_GATEWAY_PORT=8021

# 金融安全開關；正式環境必須維持以下值。
LINE_BOT_READ_ONLY=true
LINE_BOT_ALLOW_TRADING=false
LINE_BOT_REQUIRE_DECISION_READY=true
LINE_BOT_ALLOW_MODEL_RECALCULATION=false
LINE_BOT_LOG_RAW_MARKET_PAYLOAD=false
LINE_BOT_LOG_SECRETS=false
