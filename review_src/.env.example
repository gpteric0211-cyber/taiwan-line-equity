# 把你的 API key 填在 = 後面。
# Fugle 免費版建議只用在「自選股」與「個股詳細頁」，不要拿來掃台灣50全表。
FUGLE_API_KEY=

# FinMind token 可選；有 token 額度較高。沒有也可以先空白。
# 只填 token 本體，不要填 Bearer。程式會自動清掉 Bearer，但建議你直接貼 raw token。
FINMIND_TOKEN=

# 自選股 Fugle 輪詢秒數
FUGLE_WATCH_POLL_SECONDS=10

# 台灣50盤後頁資料刷新秒數
EOD_PAGE_REFRESH_SECONDS=300

# FinMind 請求保護：免費 token 600/hr，不建議打滿。
FINMIND_DELAY_SECONDS=0.6
FINMIND_HOURLY_SOFT_LIMIT=500

# 技術評分快取秒數，避免台灣50每次輪詢都重算所有指標。
SCORE_CACHE_TTL_SECONDS=300

# v2.21 stability/cache/rate-limit options
ROW_CACHE_TTL_TW50_SECONDS=300
ROW_CACHE_TTL_WATCH_SECONDS=30
FUGLE_MIN_INTERVAL_SECONDS=0.3

# Fugle quote 單次 timeout；自選股背景更新不應卡太久。
FUGLE_QUOTE_TIMEOUT_SECONDS=8

# FinMind 預設增量更新天數；完整 120 日只在手動完整補齊時執行。
FINMIND_INCREMENTAL_DAYS=30
FINMIND_BATCH_SIZE=5
FINMIND_BATCH_SLEEP_SECONDS=4

# 自選股 Fugle 是否只在盤中自動背景更新，避免盤後浪費免費額度。
FUGLE_AUTO_UPDATE_MARKET_HOURS=1

# Fugle 分價量寫入前使用的 TWSE MIS 流動性證據標的與最大資料年齡。
# 只接受 MIS 來源明示 d/tlong 為台北今日，且仍在本次交易時段內的資料。
MIS_SESSION_EVIDENCE_CODES=0050,2330
MIS_SESSION_EVIDENCE_MAX_AGE_SECONDS=300


# Optional SQLite DB path. Leave blank for portable default: data\taiwan50.db
# Relative paths are resolved from this project folder, so the whole folder remains portable.
# TAIWAN50_DB_PATH=data\taiwan50.db

# 0=一般啟動唯讀既有 DB，不做 schema migration、抓取、補齊或覆寫；1=明確允許初始化與背景更新
AUTO_REFRESH_MARKET_DATA_ON_START=0

# 只有 AUTO_REFRESH_MARKET_DATA_ON_START=1 時生效：1=連台灣50籌碼也更新
AUTO_UPDATE_TW50_ON_START=0

# Auth / production security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ISSUER=taiwan50-dashboard
ACCESS_TOKEN_MINUTES=30
SESSION_DAYS=14
AUTH_COOKIE_NAME=tw50_access_token
# Set to 1 only when served through HTTPS.
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=lax

# LINE Bot / AI machine-to-machine read-only market-data API token.
# Generate a long random value and send it as: Authorization: Bearer <token>
BOT_MARKET_DATA_TOKEN=
BOT_ENABLE_UNVERIFIED_TRADES=false

# External-event intelligence runs only in the explicit scheduled update script.
# Direct Truth Social scraping is intentionally unsupported. Configure a licensed RSS/API bridge
# and keep a contract/order/reference identifier here before enabling it.
TRUMP_SOCIAL_AUTHORIZED_FEED_URL=
TRUMP_SOCIAL_SOURCE_NAME=
TRUMP_SOCIAL_LICENSE_REFERENCE=
# JSON list: [{"id":"PROVIDER_NEWS","name":"Provider","url":"https://.../feed.xml","license_reference":"contract-123"}]
LICENSED_NEWS_FEEDS_JSON=

# Free GDELT headline/URL radar. This is unverified supplemental metadata only;
# it never enters the referee or replaces primary-source verification.
GDELT_NEWS_ENABLED=true
# Optional English DOC API query. Leave blank to use the conservative Taiwan supply-chain default.
GDELT_NEWS_QUERY=

# Cloudflare Turnstile anti-bot.
# Empty means local development mode; production should set this.
TURNSTILE_SECRET_KEY=

# SMTP email verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=台股分析系統
FROM_EMAIL=

# Unified application: all relative filesystem values resolve from project root.
EQUITY_HOST=127.0.0.1
EQUITY_PORT=8056
EQUITY_TUNNEL_MODE=off
EQUITY_LINE_WEBHOOK_SYNC=0
CLOUDFLARED_EXE_PATH=
# Optional per-probe DNS over HTTPS for networks that cannot resolve a new tunnel.
EQUITY_DOH_URL=
EQUITY_TLS_TRUST=system
EQUITY_CAPTURE_TIME=15:05
EQUITY_FINALIZE_TIME=18:30
EQUITY_NEWS_TIMES=06:15,09:00,11:30,14:00,18:00
EQUITY_TDCC_TW50_TIME=18:30
EQUITY_TDCC_WATCHLIST_TIME=18:35
EQUITY_AUTH_DB=var/private/accounts.sqlite3
EQUITY_USER_DB=var/private/portfolio.sqlite3
EQUITY_USER_KEY_FILE=var/private/portfolio.key
EQUITY_JWT_KEY_FILE=var/private/jwt.key
EQUITY_MODELS_DIR=models/ollama
EQUITY_MODEL_WARMUP=1
EQUITY_MODEL_LOAD_TIMEOUT_SECONDS=180
QWEN_VISION_CONTEXT_TOKENS=4096

# Allow the database startup check to finish before creating public ingress.
EQUITY_WEB_START_TIMEOUT_SECONDS=600

# New member signup requires working SMTP and phone verification. Never commit credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_SMS_DAILY_LIMIT=100
# Free trial only; paid Twilio accounts are refused before SMS dispatch.
PHONE_VERIFICATION_MODE=disabled
# HTTPS origin only, no path/trailing slash. Required for social login.
EQUITY_AUTH_PUBLIC_URL=
EQUITY_OAUTH_GOOGLE_CLIENT_ID=
EQUITY_OAUTH_GOOGLE_CLIENT_SECRET=
EQUITY_OAUTH_LINE_CLIENT_ID=
EQUITY_OAUTH_LINE_CLIENT_SECRET=
EQUITY_OAUTH_APPLE_CLIENT_ID=
# Apple signed client-secret JWT; renew before its expiry.
EQUITY_OAUTH_APPLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
# Enable only after account migration, verified providers and membership grants are ready.
# Web AI/image endpoints and LINE analysis then share the same expiry policy.
EQUITY_MEMBERSHIP_ENFORCEMENT=0
